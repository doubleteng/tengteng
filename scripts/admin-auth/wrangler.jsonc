{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "teng-content-studio",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../.secure-admin/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "teng-content-studio-auth", "migrations_dir": "migrations" }
  ],
  "secrets": { "required": ["SESSION_SECRET"] },
  "observability": { "enabled": false }
}
