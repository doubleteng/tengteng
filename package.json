{
  "name": "teng-portfolio-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "build:admin": "node scripts/build-admin.mjs",
    "test:admin": "node --test tests/admin*.test.mjs",
    "build:secure-admin": "node scripts/build-secure-admin.mjs",
    "test:auth": "node --test tests/admin-auth.test.mjs",
    "check:secure-admin": "wrangler deploy --config scripts/admin-auth/wrangler.jsonc --dry-run --outdir .secure-admin/worker",
    "deploy:secure-admin": "wrangler deploy --config scripts/admin-auth/wrangler.jsonc --keep-vars",
    "migrate:secure-admin": "wrangler d1 migrations apply DB --remote --config scripts/admin-auth/wrangler.jsonc",
    "test:chatbot": "node --test tests/chatbot*.test.mjs",
    "sync:chatbot": "node scripts/chatbot/sync.mjs",
    "check:chatbot": "wrangler deploy --config scripts/chatbot/wrangler.jsonc --dry-run --outdir .chatbot/worker",
    "deploy:chatbot": "wrangler deploy --config scripts/chatbot/wrangler.jsonc --keep-vars",
    "migrate:chatbot": "wrangler d1 migrations apply CHAT_DB --remote --config scripts/chatbot/wrangler.jsonc"
  },
  "dependencies": {
    "diff": "9.0.0",
    "dompurify": "3.4.16",
    "liquidjs": "10.30.0",
    "markdown-it": "15.0.2",
    "turndown": "7.2.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "linkedom": "0.18.13",
    "wrangler": "4.149.0"
  }
}
