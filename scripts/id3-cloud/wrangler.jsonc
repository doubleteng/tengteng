{
  "name": "id3-ava-walk",
  "main": "worker.mjs",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GallerySessions"
      },
      {
        "name": "VISITORS",
        "class_name": "VisitorRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GallerySessions"
      ]
    },
    {
      "tag": "v2-visitor-presence",
      "new_sqlite_classes": [
        "VisitorRoom"
      ]
    }
  ],
  "vars": {
    "ARCHIVED": "true"
  }
}
